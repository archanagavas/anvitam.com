{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "anvitam.com" }],
      "destination": "https://www.anvitam.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "X-XSS-Protection",        "value": "1; mode=block" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://platform.twitter.com https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; frame-src https://www.youtube.com https://www.instagram.com; connect-src 'self' https://generativelanguage.googleapis.com https://res.cloudinary.com;"
        }
      ]
    },
    {
      "source": "/api/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/workshops/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:webp|jpg|jpeg|png|svg|ico|woff2|woff|ttf|eot|mp4|webm))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/ssr-seo.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/api/admin.ts" },
    { "source": "/api/db-init", "destination": "/api/admin.ts" },
    { "source": "/api/generate", "destination": "/api/admin.ts?path=generate" },
    { "source": "/api/blogs", "destination": "/api/blogs.ts" },
    { "source": "/api/blogs/:id", "destination": "/api/blogs.ts?id=:id" },
    { "source": "/api/products", "destination": "/api/products.ts" },
    { "source": "/api/products/:id", "destination": "/api/products.ts?id=:id" },
    { "source": "/api/projects", "destination": "/api/projects.ts" },
    { "source": "/api/projects/:id", "destination": "/api/projects.ts?id=:id" },
    { "source": "/api/services", "destination": "/api/services.ts" },
    { "source": "/api/services/:id", "destination": "/api/services.ts?id=:id" },
    { "source": "/api/messages", "destination": "/api/messages.ts" },
    { "source": "/api/messages/:id", "destination": "/api/messages.ts?id=:id" },
    { "source": "/api/testimonials", "destination": "/api/meta.ts?resource=testimonials" },
    { "source": "/api/testimonials/:id", "destination": "/api/meta.ts?resource=testimonials&id=:id" },
    { "source": "/api/partners", "destination": "/api/meta.ts?resource=partners" },
    { "source": "/api/partners/:id", "destination": "/api/meta.ts?resource=partners&id=:id" },
    { "source": "/api/estimator-services", "destination": "/api/meta.ts?resource=estimator-services" },
    { "source": "/api/estimator-services/:id", "destination": "/api/meta.ts?resource=estimator-services&id=:id" },
    { "source": "/api/workshops", "destination": "/api/workshops.ts" },
    { "source": "/api/workshops/:id", "destination": "/api/workshops.ts?id=:id" },
    { "source": "/api/analytics", "destination": "/api/analytics.ts" },
    { "source": "/api/upload", "destination": "/api/admin.ts?path=upload" },
    { "source": "/api/tools/register", "destination": "/api/tools.ts?action=register" },
    { "source": "/api/tools/login", "destination": "/api/tools.ts?action=login" },
    { "source": "/api/tools/forgot-password", "destination": "/api/tools.ts?action=forgot-password" },
    { "source": "/api/tools/consume-credit", "destination": "/api/tools.ts?action=consume-credit" },
    { "source": "/api/tools/subscribe", "destination": "/api/tools.ts?action=subscribe" },
    { "source": "/api/tools/dodo-webhook", "destination": "/api/tools.ts?action=dodo-webhook" },
    { "source": "/api/tools/soil", "destination": "/api/tools.ts?action=soil" },
    { "source": "/api/tools/:path*", "destination": "/api/tools.ts?path=:path" },
    { "source": "/api/ai-design", "destination": "/api/ai-design.ts" },
    { "source": "/api/ai-design/:path*", "destination": "/api/ai-design.ts" },
    { "source": "/api/go", "destination": "/api/ai-design.ts?action=go" },
    { "source": "/api/go/:id", "destination": "/api/ai-design.ts?action=go&id=:id" },
    { "source": "/sitemap.xml", "destination": "/api/seo.ts?action=sitemap" },
    { "source": "/api/sitemap.xml", "destination": "/api/seo.ts?action=sitemap" },
    { "source": "/api/sitemap", "destination": "/api/seo.ts?action=sitemap" },
    { "source": "/llms.txt", "destination": "/api/seo.ts?action=llms&mode=short" },
    { "source": "/api/llms.txt", "destination": "/api/seo.ts?action=llms&mode=short" },
    { "source": "/api/llms", "destination": "/api/seo.ts?action=llms&mode=short" },
    { "source": "/llm.txt", "destination": "/api/seo.ts?action=llms&mode=short" },
    { "source": "/llm.tt", "destination": "/api/seo.ts?action=llms&mode=short" },
    { "source": "/llms-full.txt", "destination": "/api/seo.ts?action=llms&mode=full" },
    { "source": "/api/llms-full.txt", "destination": "/api/seo.ts?action=llms&mode=full" },
    { "source": "/api/llms-full", "destination": "/api/seo.ts?action=llms&mode=full" },
    { "source": "/llmsfull.txt", "destination": "/api/seo.ts?action=llms&mode=full" },
    { "source": "/llmsfull", "destination": "/api/seo.ts?action=llms&mode=full" },
    { "source": "/api/indexnow", "destination": "/api/seo.ts?action=indexnow" },
    { "source": "/:key([a-zA-Z0-9_-]{8,128})\\.txt", "destination": "/api/seo.ts?action=indexnow-key&key=:key" },
    { "source": "/((?!api/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/api/ssr-seo?path=/$1" }
  ]
}
