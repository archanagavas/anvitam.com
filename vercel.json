{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ssr-seo.ts": {
      "includeFiles": "dist/index.html",
      "maxDuration": 15
    },
    "api/*.ts": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "anvitam.com"
        }
      ],
      "destination": "https://www.anvitam.com/:path*",
      "permanent": true
    },
    {
      "source": "/projects/vanvagado-food-forest-design",
      "destination": "https://www.anvitam.com/projects/vanvagado-farm",
      "permanent": true
    },
    {
      "source": "/projects/shalimar-terrace-garden-design",
      "destination": "https://www.anvitam.com/projects/shalimar",
      "permanent": true
    },
    {
      "source": "/projects/unique-school-of-science-nadiad",
      "destination": "https://www.anvitam.com/projects/unique-school",
      "permanent": true
    },
    {
      "source": "/projects/terrace-garden-vadodara-organic-balcony-garden",
      "destination": "https://www.anvitam.com/projects/shalimar",
      "permanent": true
    },
    {
      "source": "/services/agroforestry",
      "destination": "https://www.anvitam.com/services/permaculture-design",
      "permanent": true
    },
    {
      "source": "/services/architecture-design-consultation-report",
      "destination": "https://www.anvitam.com/services/architecture-consultation",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [

    { "source": "/sitemap.xml", "destination": "/api/seo?action=sitemap" },
    { "source": "/rss.xml", "destination": "/api/seo?action=rss" },
    { "source": "/feed.xml", "destination": "/api/seo?action=rss" },
    { "source": "/atom.xml", "destination": "/api/seo?action=atom" },
    { "source": "/feed.json", "destination": "/api/seo?action=feed-json" },
    { "source": "/llms.txt", "destination": "/api/seo?action=llms" },
    { "source": "/llms-full.txt", "destination": "/api/seo?action=llms-full" },
    { "source": "/api/indexnow", "destination": "/api/seo?action=indexnow" },

    { "source": "/api/admin/:splat*", "destination": "/api/admin?path=:splat*" },
    { "source": "/api/admin", "destination": "/api/admin" },

    { "source": "/api/blog-agent", "destination": "/api/blog-agent" },

    { "source": "/api/tools/:splat*", "destination": "/api/tools?action=:splat*" },
    { "source": "/api/tools", "destination": "/api/tools" },

    { "source": "/api/blogs/:splat*", "destination": "/api/meta?resource=blogs&id=:splat*" },
    { "source": "/api/blogs", "destination": "/api/meta?resource=blogs" },

    { "source": "/api/projects/:splat*", "destination": "/api/meta?resource=projects&id=:splat*" },
    { "source": "/api/projects", "destination": "/api/meta?resource=projects" },

    { "source": "/api/services/:splat*", "destination": "/api/meta?resource=services&id=:splat*" },
    { "source": "/api/services", "destination": "/api/meta?resource=services" },

    { "source": "/api/products/:splat*", "destination": "/api/meta?resource=products&id=:splat*" },
    { "source": "/api/products", "destination": "/api/meta?resource=products" },

    { "source": "/api/testimonials/:splat*", "destination": "/api/meta?resource=testimonials&id=:splat*" },
    { "source": "/api/testimonials", "destination": "/api/meta?resource=testimonials" },

    { "source": "/api/partners/:splat*", "destination": "/api/meta?resource=partners&id=:splat*" },
    { "source": "/api/partners", "destination": "/api/meta?resource=partners" },

    { "source": "/api/workshops/:splat*", "destination": "/api/meta?resource=workshops&id=:splat*" },
    { "source": "/api/workshops", "destination": "/api/meta?resource=workshops" },

    { "source": "/api/estimator-services/:splat*", "destination": "/api/meta?resource=estimator-services&id=:splat*" },
    { "source": "/api/estimator-services", "destination": "/api/meta?resource=estimator-services" },

    { "source": "/api/messages/:splat*", "destination": "/api/messages?id=:splat*" },
    { "source": "/api/messages", "destination": "/api/messages" },

    { "source": "/api/ai-design/:splat*", "destination": "/api/ai-design?action=:splat*" },
    { "source": "/api/ai-design", "destination": "/api/ai-design" },

    { "source": "/", "destination": "/api/ssr-seo?path=/" },
    { "source": "/blog/:splat*", "destination": "/api/ssr-seo?path=/blog/:splat*" },
    { "source": "/blog", "destination": "/api/ssr-seo?path=/blog" },
    { "source": "/projects/:splat*", "destination": "/api/ssr-seo?path=/projects/:splat*" },
    { "source": "/projects", "destination": "/api/ssr-seo?path=/projects" },
    { "source": "/services/:splat*", "destination": "/api/ssr-seo?path=/services/:splat*" },
    { "source": "/services", "destination": "/api/ssr-seo?path=/services" },
    { "source": "/workshops/:splat*", "destination": "/api/ssr-seo?path=/workshops/:splat*" },
    { "source": "/workshops", "destination": "/api/ssr-seo?path=/workshops" },
    { "source": "/seo/:splat*", "destination": "/api/ssr-seo?path=/seo/:splat*" },
    { "source": "/why", "destination": "/api/ssr-seo?path=/why" },
    { "source": "/about", "destination": "/api/ssr-seo?path=/about" },
    { "source": "/contact", "destination": "/api/ssr-seo?path=/contact" },
    { "source": "/team", "destination": "/api/ssr-seo?path=/team" },
    { "source": "/shop", "destination": "/api/ssr-seo?path=/shop" },
    { "source": "/process/:splat*", "destination": "/api/ssr-seo?path=/process/:splat*" },
    { "source": "/process", "destination": "/api/ssr-seo?path=/process" },
    { "source": "/privacy", "destination": "/api/ssr-seo?path=/privacy" },
    { "source": "/terms", "destination": "/api/ssr-seo?path=/terms" },

    { "source": "/((?!api/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
